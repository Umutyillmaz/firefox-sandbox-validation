#!/usr/sbin/nft -f
# Egress policy for the shared network namespace of the egress sidecar and
# the browser container. It lives only inside this container's network
# namespace: the host firewall and other Docker networks are not touched.
#
# Placeholders filled in by entrypoint.sh: @UPSTREAM_DNS@ @DNSMASQ_UID@

table inet egress
delete table inet egress

table inet egress {
    # Filled at runtime by dnsmasq (--nftset) with the A records of allowlisted names.
    set allowed4 {
        type ipv4_addr
        comment "IPv4 addresses of allowlisted DNS names"
    }

    # Evidence: every (destination, protocol, port) that was rejected.
    set rejected4 {
        type ipv4_addr . inet_proto . inet_service
        flags dynamic
        size 4096
    }
    set rejected6 {
        type ipv6_addr . inet_proto . inet_service
        flags dynamic
        size 4096
    }

    counter dns_upstream { }
    counter allowed_https { }
    counter rejected_total { }
    counter inbound_dropped { }

    chain output {
        type filter hook output priority filter; policy drop;

        oifname "lo" accept
        ct state established,related accept
        ct state invalid drop

        # Only the dnsmasq user may reach the upstream resolver. Every other
        # process must use the filtering resolver on 127.0.0.1.
        meta skuid @DNSMASQ_UID@ ip daddr @UPSTREAM_DNS@ meta l4proto { tcp, udp } th dport 53 counter name "dns_upstream" accept

        # Approved destinations: HTTPS over TCP only. No QUIC, no plain HTTP.
        ip daddr @allowed4 tcp dport 443 counter name "allowed_https" accept

        # Everything else: record it, count it, and reject it so callers fail fast.
        meta nfproto ipv4 meta l4proto { tcp, udp } add @rejected4 { ip daddr . meta l4proto . th dport }
        meta nfproto ipv6 meta l4proto { tcp, udp } add @rejected6 { ip6 daddr . meta l4proto . th dport }
        counter name "rejected_total"
        reject with icmpx admin-prohibited
    }

    chain input {
        type filter hook input priority filter; policy drop;
        iifname "lo" accept
        ct state established,related accept
        counter name "inbound_dropped"
    }
}
